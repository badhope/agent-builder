{
  "name": "docformatconverter-miniprogram",
  "version": "1.0.0",
  "private": true,
  "description": "DocFormatConverter WeChat Mini Program",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "sass"
  },
  "scripts": {
    "build:weapp": "taro build --type weapp",
    "build:h5": "taro build --type h5",
    "build:alipay": "taro build --type alipay",
    "dev:weapp": "npm run build:weapp -- --watch",
    "dev:h5": "npm run build:h5 -- --watch",
    "dev:alipay": "npm run build:alipay -- --watch",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "dependencies": {
    "@tarojs/components": "3.6.34",
    "@tarojs/helper": "3.6.34",
    "@tarojs/plugin-platform-weapp": "3.6.34",
    "@tarojs/plugin-platform-h5": "3.6.34",
    "@tarojs/plugin-platform-alipay": "3.6.34",
    "@tarojs/react": "3.6.34",
    "@tarojs/runtime": "3.6.34",
    "@tarojs/shared": "3.6.34",
    "@tarojs/taro": "3.6.34",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@babel/preset-react": "^7.23.3",
    "@tarojs/cli": "3.6.34",
    "@tarojs/mini-runner": "3.6.34",
    "@tarojs/webpack5-runner": "3.6.34",
    "@types/react": "^18.2.0",
    "@types/webpack-env": "^1.18.0",
    "babel-plugin-import": "^1.13.8",
    "babel-preset-taro": "3.6.34",
    "eslint": "^8.57.0",
    "eslint-config-taro": "3.6.34",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "sass": "^1.71.0",
    "typescript": "^5.4.0",
    "webpack": "5.104.1"
  }
}