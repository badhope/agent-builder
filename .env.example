# ============================================================================
# DocFormatConverter — environment configuration
# Copy this file to `.env` and adjust values. Never commit real secrets.
# ============================================================================

# ---- General ----
APP_ENV=dev                      # dev | staging | prod
APP_NAME=DocFormatConverter
APP_VERSION=1.0.0
APP_DEBUG=false
APP_TIMEZONE=UTC

# ---- API ----
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_ROOT_PATH=                    # e.g. /api if behind path-prefix reverse proxy
API_CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:8000
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:8000
API_TRUSTED_HOSTS=localhost,127.0.0.1
API_BEHIND_PROXY=false

# ---- Database (async) ----
DATABASE_URL=postgresql+asyncpg://docconverter:docconverter@postgres:5432/docconverter
DATABASE_URL_SYNC=postgresql+psycopg://docconverter:docconverter@postgres:5432/docconverter
POSTGRES_USER=docconverter
POSTGRES_PASSWORD=docconverter
POSTGRES_DB=docconverter
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_RECYCLE_S=3600
DATABASE_ECHO=false

# ---- Redis ----
REDIS_URL=redis://redis:6379/0
REDIS_URL_CELERY=redis://redis:6379/1
REDIS_URL_PUBSUB=redis://redis:6379/2

# ---- JWT ----
# If keys do not exist, server generates an ephemeral RS256 pair on startup.
# In production, mount the keys from a secret manager.
JWT_ALGORITHM=RS256
JWT_ISSUER=docformatconverter
JWT_AUDIENCE=docformatconverter-api
JWT_PRIVATE_KEY_PATH=./keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt_public.pem
JWT_ACCESS_TTL_MIN=30
JWT_REFRESH_TTL_DAY=30
JWT_AUTO_GENERATE_KEYS=true

# ---- Storage ----
STORAGE_BACKEND=local            # local | s3
STORAGE_LOCAL_ROOT=./var/storage
STORAGE_PUBLIC_BASE_URL=
STORAGE_PRESIGNED_TTL_S=3600
# S3 / MinIO
S3_ENDPOINT_URL=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=conversions
S3_USE_SSL=false
S3_ADDRESSING_STYLE=path
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ---- Conversion limits ----
MAX_FILE_SIZE_MB=100
MAX_BATCH_FILES=50
MAX_BATCH_TOTAL_SIZE_MB=500
MAX_CONVERSION_TIMEOUT_S=300
MAX_PAGE_RANGE=1000

# ---- Worker ----
CELERY_CONCURRENCY=2
CELERY_PREFETCH_MULTIPLIER=1
CELERY_TASK_TIME_LIMIT_S=600
CELERY_TASK_SOFT_TIME_LIMIT_S=540

# ---- Rate limiting ----
RATE_LIMIT_DEFAULT=200/minute
RATE_LIMIT_CONVERT=10/minute
RATE_LIMIT_BATCH=5/minute
RATE_LIMIT_AUTH=20/minute
RATE_LIMIT_STORAGE=local          # local | redis
RATE_LIMITER_KEY=ip              # ip | user | apikey

# ---- Antivirus (optional) ----
ANTIVIRUS_ENABLED=false
ANTIVIRUS_HOST=clamav
ANTIVIRUS_PORT=3310
ANTIVIRUS_TIMEOUT_S=30
ANTIVIRUS_FAIL_OPEN=true         # allow on scanner error if true

# ---- Logging / observability ----
LOG_LEVEL=INFO
LOG_FORMAT=json                  # json | console
LOG_FILE=                        # path, leave empty for stdout only
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=docconverter-api
SENTRY_DSN=

# ---- Bootstrap admin (created on first start if not exists) ----
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe!2026
BOOTSTRAP_ADMIN_ENABLED=true

# ---- CORS / security ----
SECURITY_HSTS_ENABLED=false
SECURITY_HSTS_MAX_AGE=31536000
SECURITY_REFERRER_POLICY=no-referrer
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=lax

# ---- Webhook ----
WEBHOOK_TIMEOUT_S=10
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_BACKOFF_BASE_S=2
