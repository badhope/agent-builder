root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 100

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
max_line_length = off

[*.{ts,tsx,js,jsx,vue}]
indent_size = 2
quote_type = single

[Makefile]
indent_style = tab

[*.{Dockerfile,dockerfile}]
indent_size = 2
